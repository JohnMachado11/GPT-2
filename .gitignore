# Environment
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Model artifacts & data (too big / regenerable)
*.pt
*.ckpt
*.safetensors
# generated loss-curve plots (regenerated each run)
src/checkpoints/*.png
# the checkpoints/ folder + its README are kept; the *.pt weights and *.png plots inside are ignored
data/*.bin
data/*.npy
data/*.arrow

# downloaded training corpora (keep one book tracked so a fresh clone has something to train on)
src/run/data/*.txt
!src/run/data/the_war_of_the_worlds.txt

# Notebooks / editors
.ipynb_checkpoints/
.DS_Store

# Logs
*.log
runs/
wandb/
