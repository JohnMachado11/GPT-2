# Environment
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Model artifacts & data (too big / regenerable)
*.pt
*.ckpt
*.safetensors
# trained models: nothing in src/checkpoints/ is ever committed (run folders hold GBs of weights)
# -- except its README, which keeps the folder in the repo and explains how to read it
src/checkpoints/*
!src/checkpoints/README.md
data/*.bin
data/*.npy
data/*.arrow

# tokenized shard files: shards/text/ from train_on_text.py, shards/fineweb/ from prepare_data.py
# (large, regenerable)
src/run/shards/

# downloaded training corpora (keep one book tracked so a fresh clone has something to train on)
src/run/data/*.txt
!src/run/data/the_war_of_the_worlds.txt

# personal notes & scratch artifacts (kept local, never pushed)
notes/

# Notebooks / editors
.ipynb_checkpoints/
.DS_Store

# Logs
*.log
runs/
wandb/
